# Application
APP_ENV=development
APP_PORT=8080

# PostgreSQL connection string.
# Host port 5433 matches docker-compose (mapped to avoid clashing with a local 5432).
# This owner/superuser URL is used for migrations (make migrate-up) and local
# `make dev`. In the Docker stack the api/worker instead connect as the
# non-superuser teamflow_app role so Row Level Security is enforced; run the app
# as a non-superuser role in production too (superusers bypass RLS).
DATABASE_URL=postgres://teamflow:teamflow@localhost:5433/teamflow?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# HTTP server tuning
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Authentication / JWT
# Use a long, random secret in production (>= 32 chars). Do NOT use this value.
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_ISSUER=teamflow
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Organization invitations
# INVITATION_BASE_URL is the public origin of the web client that renders
# /invitations/accept; the emailed link is built from it.
INVITATION_BASE_URL=http://localhost:3000
# How long an invitation link stays valid (max 720h).
INVITATION_TTL=168h
# API keys
# A key always expires: API_KEY_DEFAULT_TTL is used when a request does not ask
# for a lifetime, and no key may outlive API_KEY_MAX_TTL.
API_KEY_DEFAULT_TTL=2160h
API_KEY_MAX_TTL=8760h

# Transactional mail transport: log | none.
# `log` writes the invitation link to the application log and is for local
# development only; configuration refuses to start with it when APP_ENV=production.
MAIL_TRANSPORT=log

# --- Rate limiting ---
# Enabled by default when APP_ENV=production, off elsewhere. Limits are token
# buckets evaluated in Redis.
#   RATE_LIMIT_AUTH_LIMIT/PERIOD   unauthenticated endpoints, keyed by client IP
#   RATE_LIMIT_USER_LIMIT/PERIOD   session traffic, keyed by user
#   RATE_LIMIT_API_KEY_LIMIT/PERIOD machine traffic, keyed by API key
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_LIMIT=10
# RATE_LIMIT_AUTH_PERIOD=1m
# RATE_LIMIT_USER_LIMIT=300
# RATE_LIMIT_USER_PERIOD=1m
# RATE_LIMIT_API_KEY_LIMIT=600
# RATE_LIMIT_API_KEY_PERIOD=1m
# Allow requests through when Redis is unavailable, so a Redis outage does not
# become an API outage. Set to false to reject instead.
# RATE_LIMIT_FAIL_OPEN=true

# --- Background worker (cmd/worker) ---
# Size of the worker pool and how long shutdown waits for in-flight jobs.
WORKER_CONCURRENCY=4
WORKER_BLOCK_TIMEOUT=2s
WORKER_STALE_AFTER=5m
WORKER_SHUTDOWN_TIMEOUT=15s

# Retry policy: WORKER_MAX_ATTEMPTS attempts with exponential backoff between
# WORKER_RETRY_BASE_DELAY and WORKER_RETRY_MAX_DELAY, then the job is
# dead-lettered in the Redis stream teamflow:jobs:dead.
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_DELAY=30s
WORKER_RETRY_MAX_DELAY=1h

# Encrypts job payloads at rest in Redis (AES-GCM). Leave empty to derive it from
# JWT_SECRET, which works out of the box but means the two must be rotated
# together. Set an independent secret in production.
# JOB_ENCRYPTION_KEY=use-a-long-random-job-encryption-secret

# --- Reserved for later phases ---
# RATE_LIMIT_ENABLED=true
