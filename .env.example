# Application
APP_ENV=development
APP_PORT=8080

# PostgreSQL connection string.
# Host port 5433 matches docker-compose (mapped to avoid clashing with a local 5432).
DATABASE_URL=postgres://teamflow:teamflow@localhost:5433/teamflow?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# HTTP server tuning
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576

# Logging: debug | info | warn | error
LOG_LEVEL=info

# --- Reserved for later phases (safe placeholders, do NOT use in production) ---
# JWT_SECRET=change-me-in-production
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=720h
# RATE_LIMIT_ENABLED=true
